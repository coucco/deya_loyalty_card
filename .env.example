# Скопируйте в .env и заполните. Секреты: openssl rand -hex 24
DOMAIN=loyalty.example.ru
ADMIN_TOKEN=                 # не короче 24 символов, вход в /admin
APP_SECRET=                  # подпись кодов из СМС и кодов активации пластиковых карт; НЕ меняйте после запуска
TRUST_PROXY=1                # сервер за Caddy/nginx: брать IP клиента из X-Forwarded-For
PUBLIC_URL=                  # адрес приложения для ссылок в СМС (пусто = https://$DOMAIN)

# Поддержка: показывается в приложении (письмо уходит с ID профиля клиента)
SUPPORT_PHONE=+7 929 838-45-16
SUPPORT_EMAIL=timurshokarov1001@gmail.com

# Резервные копии и журнал (в docker-compose BACKUP_DIR уже задан: /backups)
BACKUP_KEEP_DAYS=14
AUDIT_KEEP_DAYS=1095

# Выдача карт клиентам:
#   pool     — из пула номеров, заранее заведённых в Set10 (админка → «Пул карт»). Обязательно для работы с кассами
#   generate — сервер сам придумывает номер (только проба без Set10: касса такие карты не узнает)
CARD_ISSUE_MODE=pool
CARD_PREFIX=2000             # только для generate
CARD_LENGTH=13               # только для generate

# СМС: SMS_PROVIDER=http и шаблон URL провайдера с {phone} и {text}
SMS_PROVIDER=http
SMS_HTTP_URL=https://sms.ru/sms/send?api_id=XXXX&to={phone}&msg={text}&json=1
SMS_HTTP_AUTH=

# Резерв баллов под чек гипермаркета (подытог → оплата), сек.; резерв на 3 этаже, сек.
POS_HOLD_TTL_SEC=1800
HOLD_TTL_SEC=600

# Юридические документы. Пока юрист не подготовил тексты, используются заглушки /legal/*.html.
# При изменении текста документов увеличьте DOCS_VERSION: версия пишется в журнал согласий.
DOCS_VERSION=1
DOC_RULES_URL=/legal/rules.html
DOC_PRIVACY_URL=/legal/privacy.html
DOC_PD_CONSENT_URL=/legal/pd-consent.html
DOC_MARKETING_URL=/legal/marketing-consent.html
